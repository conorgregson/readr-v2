generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL comes from prisma.config.ts (DATABASE_URL)
}

enum BookStatus {
  planned
  reading
  finished
}

enum SeriesType {
  series
  standalone
}

enum FormatParent {
  digital
  physical
}

enum FormatSubtype {
  Hardcover
  Paperback
  ebook
  Audiobook
  PDF
}

model SavedView {
  id           String    @id @default(cuid())

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String

  filters      Json
  sortKey      String
  sortDir      String

  isPinned     Boolean   @default(false)
  isDefault    Boolean   @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isPinned])
  @@index([userId, isDefault])
  @@index([userId, updatedAt])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String

  savedView    SavedView[]

  books        Book[]
  sessions     Session[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model Book {
  id            String        @id @default(cuid())

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  author        String
  status        BookStatus    @default(planned)

  startedAt     DateTime?
  finishedAt    DateTime?

  genre         String?
  series        String?
  seriesType    SeriesType?
  format        FormatParent?
  formatSubtype FormatSubtype?
  isbn          String?
  plannedMonth  String?

  sessions      Session[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, title])
  @@index([userId, author])
  @@index([userId, genre])
  @@index([userId, series])
  @@index([userId, plannedMonth])
}

model Session {
  id        String    @id @default(cuid())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  date      DateTime
  pages     Int?
  minutes   Int?
  notes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([bookId])
  @@index([userId, date])
  @@index([userId, bookId])
}
