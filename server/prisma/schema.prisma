generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL comes from prisma.config.ts (DATABASE_URL)
}

enum BookStatus {
  planned
  reading
  finished
}

enum SeriesType {
  series
  standalone
}

enum FormatParent {
  digital
  physical
}

enum FormatSubtype {
  Hardcover
  Paperback
  ebook
  Audiobook
  PDF
}

model Book {
  id            String      @id @default(cuid())
  title         String
  author        String

  status        BookStatus  @default(planned)

  startedAt     DateTime?
  finishedAt    DateTime?

  genre         String?
  series        String?
  seriesType    SeriesType?
  format        FormatParent?
  formatSubtype FormatSubtype?
  isbn          String?
  plannedMonth  String?

  sessions      Session[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([title])
  @@index([author])
  @@index([genre])
  @@index([series])
  @@index([plannedMonth])
}

model Session {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  date      DateTime
  pages     Int?
  minutes   Int?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([date])
}
