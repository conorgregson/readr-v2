{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "Node",
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["src", "../shared"]
}
